{
  "name": "thien-kieu-bi-canh",
  "version": "15.0.0-rc.0",
  "private": true,
  "description": "Thiên Kiêu Bí Cảnh V14 - Commercial Edition (web app học ngoại ngữ qua video, game hoá)",
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "build:check": "node tools/build.mjs --check",
    "build:sh": "sh ./build.sh",
    "build:css": "tailwindcss -c tailwind.config.cjs -i src/styles/tailwind.css -o css/tailwind.css --minify",
    "dev": "vite",
    "build:vite": "vite build",
    "test": "node tools/run-tests.mjs root",
    "test:frontend": "node tools/run-tests.mjs frontend",
    "test:functions": "node tools/run-tests.mjs functions",
    "test:all": "node tools/run-tests.mjs all",
    "test:integration": "node --test tests/integration/",
    "test:rules": "firebase emulators:exec --config firebase.emulator-hardened.json --project demo-tkbc --only firestore \"node tools/run-tests.mjs rules\"",
    "check:globals": "node tools/check-globals.cjs",
    "check": "node tools/preflight.mjs && node tools/check-globals.cjs",
    "emulators": "firebase emulators:start --config firebase.emulator-full.json --project demo-tkbc",
    "emulators:seed": "node tools/seed-emulator.mjs",
    "rules:activate-hardened": "node -e \"require('fs').copyFileSync('firestore.rules.hardened','firestore.rules')\""
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "tailwindcss": "3.4.17",
    "postcss": "^8.4.49",
    "autoprefixer": "^10.4.20",
    "vite": "^5.4.11",
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.0.0",
    "firebase-tools": "^13.0.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": "22.x"
  }
}
