{
  "name": "thien-kieu-bi-canh",
  "version": "2.0.0",
  "private": true,
  "description": "Thiên Kiêu Bí Cảnh - web app học ngoại ngữ qua video (phi thương mại)",
  "type": "module",
  "scripts": {
    "build": "sh ./build.sh",
    "build:css": "tailwindcss -c tailwind.config.cjs -i src/styles/tailwind.css -o css/tailwind.css --minify",
