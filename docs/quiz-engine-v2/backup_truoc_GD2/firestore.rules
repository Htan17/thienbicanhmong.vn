rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function changedKeys() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function oldList(field) { return resource.data.get(field, []); }
    function newList(field) { return request.resource.data.get(field, []); }
    // Quản trị viên = có tài liệu admins/{uid} (chỉ tạo bằng tay trong Firebase Console)
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function isHidden(key) { return exists(/databases/$(database)/documents/hiddenContent/$(key)); }

    // ===== users/{uid} =====
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isOwner(uid);
      allow delete: if isOwner(uid);

      allow update: if
        // Chủ tài khoản được sửa hồ sơ của mình (gồm khôi phục chuỗi, Linh Thạch, Danh Vọng...)
        isOwner(uid)
        // Gửi lời mời kết bạn / tông môn: chỉ được THÊM vào danh sách requests của người khác
        || (signedIn() && changedKeys().hasOnly(['requests'])
            && newList('requests').size() >= oldList('requests').size())
        // Kết bạn hai chiều: chỉ được thêm đúng UID của chính mình vào friends
        || (signedIn() && changedKeys().hasOnly(['friends'])
            && newList('friends').size() <= oldList('friends').size() + 1
            && newList('friends').hasAny([request.auth.uid]))
        // Trục xuất khỏi tông môn: chỉ được đặt guild = null
        || (signedIn() && changedKeys().hasOnly(['guild'])
            && request.resource.data.guild == null)
        // Thưởng cuối mùa: chỉ được TĂNG Linh Thạch/Danh Vọng, giới hạn mỗi lần
        || (signedIn() && changedKeys().hasOnly(['spirit', 'fame'])
            && request.resource.data.get('spirit', 0) >= resource.data.get('spirit', 0)
            && request.resource.data.get('spirit', 0) - resource.data.get('spirit', 0) <= 10000
            && request.resource.data.get('fame', 0) >= resource.data.get('fame', 0)
            && request.resource.data.get('fame', 0) - resource.data.get('fame', 0) <= 10000)
        // Đặt lại điểm mùa / điểm Đạo Lộ trong ngày: chỉ được về 0
        || (signedIn() && changedKeys().hasOnly(['seasonScore'])
            && request.resource.data.seasonScore == 0)
        || (signedIn() && changedKeys().hasOnly(['seasonScore', 'seasonLessons'])
            && request.resource.data.get('seasonScore', 0) == 0
            && request.resource.data.get('seasonLessons', 0) == 0)
        || (signedIn() && changedKeys().hasOnly(['examPathDailyScore'])
            && request.resource.data.examPathDailyScore == 0)
        // Trao danh hiệu Đạo Lộ cuối ngày
        || (signedIn() && changedKeys().hasOnly(['examPathTitles']));

      // Khoá Gemini API riêng: chỉ chủ tài khoản
      match /private/{docId} {
        allow read, write: if isOwner(uid);
      }

      // Dữ liệu ôn từ vựng (SRS): chỉ chủ tài khoản
      match /srs/{docId} {
        allow read, write: if isOwner(uid);
      }
    }

    // ===== guilds/{id} (Tông Môn) =====
    match /guilds/{gid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.leader == request.auth.uid;
      allow update: if signedIn() && (
        resource.data.leader == request.auth.uid
        || changedKeys().hasOnly(['members', 'exp'])
      );
      allow delete: if signedIn() && (
        resource.data.leader == request.auth.uid
        || resource.data.get('members', []).size() == 0
      );
    }

    // ===== quizShares/{code} (Mã Bí Tịch ngắn 8 ký tự) =====
    match /quizShares/{code} {
      // Bí Tịch bị quản trị viên ẩn thì máy chủ từ chối trả về (kiểm duyệt có hiệu lực thật, không chỉ ở giao diện)
      allow get: if signedIn() && !isHidden('quiz__' + code);
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['t', 'd', 'owner', 'createdAt'])
        && request.resource.data.owner == request.auth.uid;
      allow update: if false;
      allow delete: if signedIn() && (resource.data.owner == request.auth.uid || isAdmin());
    }

    // ===== meta/* (mốc đặt lại mùa) =====
    match /meta/{docId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.resource.data.keys().hasOnly(['nextReset']);
    }

    // ===== videoShares/{code} (mã chia sẻ video) =====
    match /videoShares/{code} {
      allow get: if signedIn() && !isHidden('video__' + code);
      allow list: if false;
      allow create: if signedIn();
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ===== KIỂM DUYỆT CỘNG ĐỒNG (Lộ trình #3) =====
    // admins/{uid}: chỉ chủ tài khoản đọc được tài liệu của mình (để biết mình có phải admin); KHÔNG ai ghi được từ client.
    match /admins/{uid} {
      allow get: if isOwner(uid);
      allow list, write: if false;
    }

    // reports/{reporterUid__type__id}: mỗi người báo cáo 1 lần / đối tượng (create-only), chỉ admin duyệt.
    match /reports/{rid} {
      allow get: if isAdmin() || (signedIn() && rid.matches(request.auth.uid + '__.*'));
      allow list: if isAdmin();
      allow create: if signedIn()
        && rid.matches(request.auth.uid + '__.*')
        && request.resource.data.keys().hasOnly(['targetType', 'targetId', 'targetLabel', 'reason', 'note', 'reporter', 'status', 'createdAt'])
        && request.resource.data.keys().hasAll(['targetType', 'targetId', 'reason', 'reporter', 'status', 'createdAt'])
        && request.resource.data.reporter == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.targetType in ['user', 'guild', 'quiz', 'video']
        && request.resource.data.targetId is string && request.resource.data.targetId.size() > 0 && request.resource.data.targetId.size() <= 200
        && request.resource.data.reason in ['abuse', 'sexual', 'scam', 'impersonate', 'privacy', 'other']
        && request.resource.data.get('note', '') is string && request.resource.data.get('note', '').size() <= 200
        && request.resource.data.get('targetLabel', '') is string && request.resource.data.get('targetLabel', '').size() <= 80
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewedAt'])
        && request.resource.data.status in ['hidden', 'dismissed'];
      allow delete: if isAdmin();
    }

    // hiddenContent/{type__id}: nội dung bị ẩn. Mọi người đã đăng nhập đọc được (để che), chỉ admin ghi.
    match /hiddenContent/{key} {
      allow read: if signedIn();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['targetType', 'targetId', 'reason', 'hiddenBy', 'hiddenAt'])
        && request.resource.data.hiddenBy == request.auth.uid;
      allow delete: if isAdmin();
    }

    // Mọi thứ còn lại: chặn
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
